# Maps api key for routing
GOOLGE_MAPS_API_KEY=""
MAX_REQUESTS_PER_CALL="1000"

# Supabase Auth: separate project/keys for each environment. CAP still owns all app data.
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="" # release validation only; same project as client
SUPABASE_SECRET_KEY="" # server-only sb_secret_...; never EXPO_PUBLIC_*
SUPABASE_ACCOUNT_DELETION_MODE="" # dedicated-project only after operator verifies scope
MOBILE_CORS_ORIGINS="http://localhost:4004" # explicit production allowlist required

# Legacy Auth0 deletion queue ONLY: retain until all NULL/auth0 provider jobs complete.
ISSUER_BASE_URL="https://LEGACY-TENANT.auth0.com/"
# Server-only M2M credentials: Auth0 Management API scope delete:users.
# Use a dedicated Auth0 tenant/application for this app; never EXPO_PUBLIC_*.
# Confirm this Auth0 tenant is dedicated to Harzer Wanderbuddy; deletion removes its Auth0 user.
AUTH0_ACCOUNT_DELETION_MODE="" # dedicated-tenant after verification
AUTH0_MANAGEMENT_CLIENT_ID=""
AUTH0_MANAGEMENT_CLIENT_SECRET=""
# Real Supabase provider/staging acceptance is still pending.
# SUPABASE_AUTH_MIGRATION blocks legal readiness unconditionally until real staging acceptance.
# It is not an environment variable that can be enabled.
# Optional overrides below are only needed if the deployment changes.
# LEGAL_TRANSFER_DETAILS still requires the actual agreed DPAs/transfer safeguards.
LEGAL_HOSTING_DETAILS=""
LEGAL_TRANSFER_DETAILS=""
LEGAL_BACKUP_RETENTION=""
LEGAL_AUTH_RETENTION=""
LEGAL_LOG_RETENTION=""
# Set only after Cloud Scheduler -> Cloud Run Job has been deployed and tested.
ACCOUNT_DELETION_SCHEDULER_CONFIRMED="" # true
# Optional, only when actually assigned/applicable:
LEGAL_REGISTER_DETAILS=""
LEGAL_VAT_ID="DE462683424" # confirmed operator VAT ID; default also included in legal content
