{
  "name": "hwb",
  "version": "2.7.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.12.8",
    "@cap-js/attachments": "^1.2.1",
    "@cap-js/postgres": "^1.8.0",
    "@sap/cds": "^8",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4",
    "express-openid-connect": "^2.17.1",
    "hwb": "file:",
    "jose": "^6.2.1",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "sqlite3": "^5.0.8",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^7"
  },
  "scripts": {
    "dev:basic:cap": "npm run watch:basic",
    "dev:sso:cap": "npm run watch:sso",
    "test": "node --test test/*.test.js",
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy": "cds deploy",
    "deploy:sqlite": "node util/deploySqlite.js",
    "deploy:postgres": "cds deploy --profile production",
    "watch-frontendhwb": "cds watch --open frontendhwb/webapp/index.html?sap-ui-xx-viewCache=false",
    "download-csv-exports": "node util/downloadCsvExports.js",
    "watch:basic": "node util/prepareLocalDatabase.js && cds watch --profile dev-basic",
    "start:basic": "node util/prepareLocalDatabase.js && cds serve --profile dev-basic",
    "watch:sso": "node util/prepareLocalDatabase.js && cds watch --profile dev-sso",
    "start:sso": "node util/prepareLocalDatabase.js && cds serve --profile dev-sso"
  },
  "cds": {
    "requires": {
      "attachments": {
        "scan": false,
        "kind": "db"
      },
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[memory]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "[production]": {
          "impl": "@cap-js/postgres",
          "kind": "postgres",
          "pool": {
            "acquireTimeoutMillis": 5000,
            "min": 0,
            "max": 10,
            "fifo": true,
            "evictionRunIntervalMillis": 5000,
            "idleTimeoutMillis": 30000
          }
        },
        "[dev-basic]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.local.db"
          }
        },
        "[dev-sso]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.local.db"
          }
        }
      },
      "auth": {
        "[developmentBasic]": {
          "kind": "basic-auth",
          "users": {
            "Tris": {
              "pass": "pass"
            },
            "Momo": {
              "pass": "pass"
            },
            "Lars": {
              "pass": "pass"
            },
            "Kevin": {
              "pass": "pass",
              "roles": [
                "dummy"
              ]
            },
            "Alice": {
              "pass": "pass"
            },
            "*": false
          }
        },
        "[development]": {
          "impl": "srv/auth.js"
        },
        "[production]": {
          "impl": "srv/auth.js"
        },
        "[dev-basic]": {
          "kind": "basic",
          "impl": "srv/basic-auth.js",
          "users": {
            "user1@hwb.de": {
              "password": "user1@hwb.deA",
              "roles": [
                "authenticated-user"
              ]
            },
            "*": false
          }
        },
        "[dev-sso]": {
          "impl": "srv/auth.js"
        }
      }
    }
  },
  "eslintConfig": {
    "extends": "eslint:recommended",
    "env": {
      "es2020": true,
      "node": true,
      "jest": true,
      "mocha": true
    },
    "globals": {
      "SELECT": true,
      "INSERT": true,
      "UPDATE": true,
      "DELETE": true,
      "CREATE": true,
      "DROP": true,
      "CDL": true,
      "CQL": true,
      "CXL": true,
      "cds": true
    },
    "rules": {
      "no-console": "off",
      "require-atomic-updates": "off"
    }
  },
  "hwbProfiles": {
    "dev-basic": {
      "description": "Lokaler CAP-Server mit SQLite und HTTP Basic Auth; benötigt kein Auth0.",
      "watch": "npm run dev:basic:cap",
      "start": "npm run start:basic",
      "frontend": "Im zweiten Terminal: npm run dev:basic:web --prefix app (vom Projektroot).",
      "url": "http://localhost:8081/login",
      "testCredentials": "../../AGENTS.md"
    },
    "dev-sso": {
      "description": "Lokaler CAP-Server mit SQLite und Auth0 SSO.",
      "watch": "npm run dev:sso:cap",
      "start": "npm run start:sso",
      "frontend": "npm run dev:sso:web:build --prefix app (vom Projektroot).",
      "url": "http://localhost:4004/app/rnweb"
    },
    "production": {
      "description": "Bestehendes Container-Profil mit PostgreSQL und Auth0; unverändert.",
      "start": "npm start (im bestehenden Container mit Produktionsprofil)"
    },
    "note": "Nur einen CAP-Server auf Port 4004 starten; vor dem Profilwechsel den laufenden Server beenden."
  }
}
