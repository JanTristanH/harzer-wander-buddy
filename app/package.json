{
  "name": "harzer-wander-buddy-app",
  "main": "expo-router/entry",
  "version": "1.5.3",
  "scripts": {
    "dev:basic:web": "npm run web:basic",
    "dev:basic:native": "npm run start:basic",
    "dev:sso:web:build": "bash ../scripts/build-and-copy-rnweb.sh",
    "dev:sso:native": "EXPO_PUBLIC_AUTH_MODE=sso expo start",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "generate:map-markers": "node ./scripts/generate-map-marker-pngs.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8081",
    "build:preview:android:local": "EXPO_PUBLIC_BACKEND_URL=https://app.harzer-wander-buddy.de npx eas build --platform android --profile preview --local",
    "update:preview:android": "EXPO_PUBLIC_BACKEND_URL=https://app.harzer-wander-buddy.de npx eas update --channel preview --platform android",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "patch-package",
    "web:basic": "EXPO_PUBLIC_AUTH_MODE=basic EXPO_PUBLIC_BACKEND_URL=http://localhost:4004 expo start --web --port 8081",
    "start:basic": "EXPO_PUBLIC_AUTH_MODE=basic EXPO_PUBLIC_BACKEND_URL=http://localhost:4004 expo start",
    "build:web:sso": "EXPO_PUBLIC_AUTH_MODE=sso expo export --platform web"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@tanstack/.*))"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-gl-leaflet": "^0.1.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/query-async-storage-persister": "^5.90.21",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.21",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.10",
    "expo-background-fetch": "~14.0.9",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-insights": "~0.10.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "odata-query": "^8.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true,
  "hwbProfiles": {
    "dev-basic": {
      "description": "Lokale HTTP Basic Auth mit Loginformular; CAP und Expo separat starten.",
      "backend": "Im zweiten Terminal: npm run dev:basic:cap --prefix backend/hwb (vom Projektroot).",
      "web": "npm run dev:basic:web",
      "native": "npm run dev:basic:native",
      "url": "http://localhost:8081/login",
      "testCredentials": "../AGENTS.md"
    },
    "dev-sso": {
      "description": "Auth0 SSO; Web-Build wird über CAP ausgeliefert. Nach App-Änderungen erneut bauen und Browser neu laden.",
      "backend": "npm run dev:sso:cap --prefix backend/hwb (vom Projektroot).",
      "webBuildAndCopy": "npm run dev:sso:web:build",
      "native": "npm run dev:sso:native",
      "url": "http://localhost:4004/app/rnweb",
      "note": "Expo Web nicht direkt für SSO starten; Expo start ist hier nur für native Entwicklung."
    },
    "production": {
      "description": "SSO-Web-Build und bestehender Container-Ablauf bleiben unverändert."
    }
  }
}
